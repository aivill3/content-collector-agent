# 네이버 검색 API — API HUB 키 권장 (구 개발자센터 방식은 2027-06-30 지원 종료)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API_MODE=auto        # hub | legacy | auto

REQUEST_TIMEOUT=10
MAX_WORKERS=8

# 게시판 수집 예절
BOARD_REQUEST_DELAY=1.0
BOARD_MAX_WORKERS=2
RESPECT_ROBOTS=true

# 표시·집계 기준 시간대 (IANA 이름). DB 는 항상 UTC 로 저장한다.
DISPLAY_TZ=Asia/Seoul

# DB — 비우면 backend/data/app.db (SQLite). 운영은 PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/content_collector
DATABASE_URL=
